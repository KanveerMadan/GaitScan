  "/analyses": {
   "post": {
    "description": "Queue an analysis and return at once; poll the status_url (Plan V3 Phase 4). Checks that need\nno pose model (file type, test, calibration, length, frame rate) answer here, straight away.",
    "operationId": "submit_analysis_analyses_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_submit_analysis_analyses_post"
       }
      }
     },
     "required": true
    },
    "responses": {
     "202": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/JobQueued"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "OAuth2PasswordBearer": []
     }
    ],
    "summary": "Submit Analysis",
    "tags": [
     "analysis"
    ]
   }
  },
