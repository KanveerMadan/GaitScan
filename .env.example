# Copy to .env for local development. Never commit real values.

# "dev" enables /docs, localhost CORS and an ephemeral JWT secret.
# Anything else (the default) is production: the app refuses to start unless
# JWT_SECRET and CORS_ORIGINS are set correctly.
ENV=dev

# >= 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated frontend origins allowed by CORS (required in production).
CORS_ORIGINS=http://localhost:3000

# Postgres in production; falls back to local SQLite when unset.
DATABASE_URL=postgresql://user:password@localhost:5432/gaitscan

# Optional
ACCESS_TOKEN_MINUTES=720
MAX_UPLOAD_MB=100

# Off by default: when on, exercise explanations are generated by Groq and the
# measurement summary is sent to Groq's API.
ENABLE_LLM_EXPLANATIONS=false
GROQ_API_KEY=
